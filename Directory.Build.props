<Project>
  <!--
    這裡只放對「所有」專案都成立的設定。
    Platforms / PlatformTarget 之類 MSIX 專屬的設定放在 src/Inkling/Inkling.csproj,
    因為測試專案與工具專案跑在 AnyCPU，套上 x64;ARM64 會讓 dotnet test 直接失敗。
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!--
      每個專案各自的 packages.lock.json 進版控:actions/setup-dotnet 的 cache: true
      要靠雜湊這份檔案當快取鍵，沒有它會直接丟錯(不是退化成不快取)。CI 因此也才鎖得住
      「還原到的版本」，不會被上游套件的新 patch 版悄悄換掉。
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
