# 這份檔案讓外來 PR 的格式不靠 review 擋。C# 的規則照 src/ 與 tests/ 現有程式碼
# 的實際風格寫(4 空格縮排、Allman 大括號、file-scoped namespace、System using 排最前),
# 不是從範本抄的 —— 改風格請連這裡一起改。

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# 換行跟 .gitattributes 同一套契約(那邊是 * text=auto,提交一律存 LF)——
# 兩份檔案講的是同一件事,改一邊記得改另一邊。
end_of_line = lf

[*.{csproj,props,targets,resx,pubxml,appxmanifest,manifest,slnx,config}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{ps1,psm1}]
indent_size = 4
indent_style = space

# PowerShell 走 CRLF,與 .gitattributes 的 *.ps1 text eol=crlf 一致。
end_of_line = crlf

[*.md]
# Markdown 的行尾雙空格是語義(換行),不能修掉。
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
indent_style = space

# using 排序:System 排最前(現有檔案全是這個順序)。
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# file-scoped namespace(全專案一致)。
csharp_style_namespace_declarations = file_scoped:warning

# Allman 大括號:左大括號一律獨立一行。
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# var:現有程式碼型別明顯時用 var,這裡只寬鬆建議,不擋 build。
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion

# 修飾詞與可讀性的基本要求,與現有程式碼一致。
dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning
dotnet_style_readonly_field = true:warning
